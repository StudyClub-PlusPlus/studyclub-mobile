// Checked-in configuration for Google OAuth and the API host.
// OAuth client IDs are public identifiers (they ship inside the app binary), not secrets.
// The iOS client is bound to the bundle ID life.studyclub. GID_SERVER_CLIENT_ID is the web
// client the server uses to exchange the serverAuthCode.
GID_CLIENT_ID = 310991078079-m1lpeun69qvks63r6c9gjac9pqljkvl1.apps.googleusercontent.com
GID_SERVER_CLIENT_ID = 310991078079-cmcgg14ce540qu75mp5cu81dhc8hp3e8.apps.googleusercontent.com
GID_REVERSED_CLIENT_ID = com.googleusercontent.apps.310991078079-m1lpeun69qvks63r6c9gjac9pqljkvl1

// API host without scheme. Debug/Stage builds override it in Config.stage.xcconfig.
API_HOST = api.studyclub-plusplus.com

// Optional developer/QA local override (git-ignored)
#include? "Config.local.xcconfig"
